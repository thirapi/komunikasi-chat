# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit only the template, never real secrets.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# open next cloudflare
.open-next/


# capacitor native builds
/ios/Pods
/ios/App/Pods
/ios/App/App/public
/ios/App/build
/ios/App/App.xcworkspace/xcuserdata
/android/app/build
/android/app/src/main/assets/public
/android/.gradle
/android/local.properties

# local build artifacts (APK)
build-artifacts/

# Firebase credentials — NEVER commit these.
# The service account holds a private key that can send push to every device.
# google-services.json is regenerated from the Firebase console; the
# service-account JSON is only ever supplied through .env / CI secrets.
android/app/google-services.json
android/app/*firebase-adminsdk*.json
android/app/service-account*.json

# generated by next-sitemap on every build
/public/sitemap-0.xml
/public/sitemap.xml

# Android release signing — never commit these.
# The keystore is the app's permanent identity. If it is lost, or the password
# with it, the app can never be updated again: Android refuses an update signed
# with a different key. Keep an offline backup somewhere you will not lose it.
android/keystore.properties
*.jks
*.keystore

# Python bytecode from scripts/build-icons.py
__pycache__/
*.pyc
